<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        AppSweep Theme - Light, Clean, Modern
        Uses Material 3 (Material You) with a blue primary color
    -->
    <style name="Theme.AppSweep" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="android:colorPrimary">@color/blue_500</item>
        <item name="android:colorPrimaryDark">@color/blue_700</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/white</item>
    </style>
</resources>
